# Copy this file to .env and fill in the values you need.

# --- LLM provider ---
# "fake"   -> extractive, offline, no API key needed (default, used for demos/tests)
# "openai" -> real generation via OpenAI chat completions
LLM_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4o-mini

# --- Embeddings provider ---
# "local" -> deterministic offline hashing embedder, no API key needed (default)
# "openai" -> real embeddings via OpenAI embeddings API
EMBEDDINGS_PROVIDER=local
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Vector store ---
# "faiss"    -> local in-memory/on-disk index, no external services needed (default)
# "pgvector" -> Postgres + pgvector, see docker-compose.yml
VECTOR_STORE=faiss
FAISS_INDEX_PATH=./data/faiss_index

POSTGRES_DSN=postgresql://finregrag:finregrag@localhost:5432/finregrag

# --- Ingestion ---
DOCS_DIR=./data/sample_docs
CHUNK_SIZE=800
CHUNK_OVERLAP=120

# --- Retrieval ---
TOP_K=4
